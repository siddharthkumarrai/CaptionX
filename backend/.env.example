# App Configuration
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_random_string_32_chars_min
ALLOWED_ORIGINS=["http://localhost:3000","https://captionx.app","null"]

# JWT Authentication
JWT_SECRET=change_this_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql+asyncpg://captionx:captionx@localhost:5432/captionx

# Redis & Celery (via Docker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 / Cloudflare R2 Storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=captionx-assets
S3_REGION=us-east-1
CDN_BASE_URL=https://cdn.captionx.app

# WhisperX Settings
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Billing (Lemon Squeezy)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_PRODUCT_PRO=
LEMON_SQUEEZY_PRODUCT_AGENCY=
